{
  "name": "chessiq-server",
  "version": "3.3.0",
  "private": true,
  "description": "ChessIQ Backend API Gateway, Telemetry Engine & Worker Queue",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
