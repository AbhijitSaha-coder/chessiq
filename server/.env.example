# ChessIQ v3.3.0 Environment Configuration Baseline

# Server & Network Topology
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# PostgreSQL 16 Connection String (Docker Local or Neon Serverless with sslmode=require)
DATABASE_URL=postgres://chessiq_admin:chessiq_dev_password@localhost:5432/chessiq

# Security Secrets (Must be at least 64 hex/alphanumeric characters each)
JWT_SECRET=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
COOKIE_SECRET=fedcba9876543210fedcba9876543210fedcba9876543210fedcba9876543210fedcba9876543210fedcba9876543210

# Stockfish NNUE Distributed Engine Configuration
STOCKFISH_PATH=/usr/games/stockfish
STOCKFISH_THREADS=1
STOCKFISH_HASH_MB=64
STOCKFISH_DEPTH=14
STOCKFISH_SEARCH_TIMEOUT_MS=8000
STOCKFISH_KILL_GRACE_MS=1500
MAX_CONCURRENT_JOBS=1
