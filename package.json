{
  "name": "chessiq-monorepo",
  "version": "3.3.0",
  "private": true,
  "description": "ChessIQ v3.3.0 — Production-Frozen, 6NF Longitudinal Chess Analytics & Distributed Stockfish Engine Platform",
  "author": "ChessIQ Systems Architecture Team",
  "license": "UNLICENSED",
  "workspaces": [
    "server",
    "client"
  ],
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"blue,green\" \"npm run dev --workspace=server\" \"npm run dev --workspace=client\"",
    "dev:server": "npm run dev --workspace=server",
    "dev:client": "npm run dev --workspace=client",
    "migrate": "node server/src/db/migrate.js",
    "test": "npm run test --workspace=server --if-present && npm run test --workspace=client --if-present",
    "lint": "npm run lint --workspace=server --if-present && npm run lint --workspace=client --if-present",
    "format": "prettier --write \"**/*.{js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{js,jsx,json,md}\"",
    "build": "npm run build --workspace=client",
    "verify:day1": "bash scripts/verify-day1.sh",
    "verify:day2": "bash scripts/verify-day2.sh",
    "verify:day3": "bash scripts/verify-day3.sh",
    "verify:day4": "bash scripts/verify-day4.sh",
    "verify:day5": "bash scripts/verify-day5.sh",
    "verify:day6": "bash scripts/verify-day6.sh",
    "verify:day7": "bash scripts/verify-day7.sh",
    "verify:day8": "bash scripts/verify-day8.sh",
    "verify:day9": "bash scripts/verify-day9.sh",
    "verify:day10": "bash scripts/verify-day10.sh",
    "verify:day11": "bash scripts/verify-day11.sh",
    "verify:day12-14": "bash scripts/verify-day12-14.sh",
    "verify:day15-16": "bash scripts/verify-day15-16.sh"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "prettier": "^3.2.5"
  },
  "allowScripts": {
    "bcrypt@5.1.1": true,
    "esbuild@0.21.5": true
  }
}
